{{define "frag-knowledge-documents"}}{{/* Collection documents (OA-22). Served
     by GET /dashboard/partials/knowledge/documents?collection=&status= and
     rendered inline. Rows are the caller's authorized set (OA-21); the 3s
     poll trigger renders only while a non-terminal status exists. Upload /
     Retry / Delete render only when .Data.Writable — a readable collection
     the caller cannot write gets the Read-only pill instead, and upload
     failures land in the persistent #knowledge-documents-error slot. The
     status chips are navigation links (aria-current), never toggles. */}}
<div id="knowledge-documents" hx-get="/dashboard/partials/knowledge/documents?collection={{.Data.Collection.ID}}&status={{.Data.Status}}" hx-swap="outerHTML" hx-trigger="{{if .Data.AnyProcessing}}refresh from:body, every 3s{{else}}refresh from:body{{end}}">
  {{template "knowledge-reembed-progress" .}}
  <div class="filters" role="group" aria-label="Filter documents by status">
    <a class="chip{{if eq .Data.Status "all"}} active{{end}}"{{if eq .Data.Status "all"}} aria-current="true"{{end}} href="/dashboard/knowledge/{{.Data.Collection.ID}}/documents">All</a>
    <a class="chip{{if eq .Data.Status "ready"}} active{{end}}"{{if eq .Data.Status "ready"}} aria-current="true"{{end}} href="/dashboard/knowledge/{{.Data.Collection.ID}}/documents?status=ready">{{statusLabel "document" "ready"}}</a>
    <a class="chip{{if eq .Data.Status "processing"}} active{{end}}"{{if eq .Data.Status "processing"}} aria-current="true"{{end}} href="/dashboard/knowledge/{{.Data.Collection.ID}}/documents?status=processing">{{statusLabel "document" "processing"}}</a>
    <a class="chip{{if eq .Data.Status "failed"}} active{{end}}"{{if eq .Data.Status "failed"}} aria-current="true"{{end}} href="/dashboard/knowledge/{{.Data.Collection.ID}}/documents?status=failed">{{statusLabel "document" "failed"}}</a>
    <a class="chip{{if eq .Data.Status "removed"}} active{{end}}"{{if eq .Data.Status "removed"}} aria-current="true"{{end}} href="/dashboard/knowledge/{{.Data.Collection.ID}}/documents?status=removed">{{statusLabel "document" "removed"}}</a>
  </div>
  <p id="knowledge-documents-error" class="field-error" role="alert" hidden></p>
{{if .Data.Docs}}  <div class="tablewrap" role="region" tabindex="0" aria-label="Documents">
    <table>
      <thead>
        <tr>
          <th scope="col">Document</th>
          <th scope="col">Status</th>
          <th scope="col">Updated</th>
{{if .Data.Writable}}          <th scope="col">Actions</th>
{{end}}        </tr>
      </thead>
      <tbody>
{{range .Data.Docs}}        <tr>
          <td data-label="Document"><b>{{.FileName}}</b>{{if .SourceURI}}<span class="subline">{{.SourceURI}}</span>{{end}}</td>
          <td data-label="Status">{{if dashboardNonTerminal .Status}}<span class="pulse" aria-hidden="true">●</span>{{end}}{{statusPill "document" .Status}}{{if .Warnings}} {{statusPill "document" "warning"}}{{range .Warnings}}<span class="subline">{{.}}</span>{{end}}{{end}}{{if .ErrorMessage}}{{$action := dashboardErrorAction .ErrorMessage $.Can}}<span class="subline">{{$action.Text}}{{if $action.Href}} <a href="{{$action.Href}}">{{if eq $action.Href "/dashboard/models/pricing"}}Set price{{else}}View details{{end}}</a>{{end}}</span>{{end}}</td>
          <td data-label="Updated">{{relTime .UpdatedAt}}</td>
{{if $.Data.Writable}}          <td data-label="Actions">
            <span class="row">
              <button type="button" class="btn" data-action="knowledge:retry" data-document-id="{{.ID}}">{{icon "refresh"}}Retry</button>
              <button type="button" class="btn danger" data-action="confirm" data-confirm="Delete document {{.FileName}}?" data-knowledge-doc-del="1" data-document-id="{{.ID}}">Delete</button>
            </span>
          </td>
{{end}}        </tr>
{{end}}      </tbody>
    </table>
  </div>
{{else}}{{template "empty" .Data.Empty}}
{{end}}{{if .Data.Writable}}  <div class="row" style="margin-top:12px">
    <input type="file" id="knowledge-upload-file" class="visually-hidden" data-knowledge-upload-input aria-label="Choose a document to upload">
{{if .Data.Docs}}    <label class="btn primary" for="knowledge-upload-file">{{icon "upload"}}Upload document</label>{{end}}
  </div>
{{else}}  <p class="row readonly-note" style="margin-top:12px"><span class="pill readonly">Read-only</span><span class="muted">Ask a knowledge manager to grant write access.</span></p>
{{end}}</div>
{{end}}
{{define "knowledge-reembed-progress"}}
<div id="knowledge-reembed-progress" hx-get="/dashboard/partials/knowledge/documents?collection={{.Data.Collection.ID}}&status={{.Data.Status}}" hx-select="#knowledge-reembed-progress" hx-swap="outerHTML" hx-trigger="{{if gt .Data.ReembedPending 0}}refresh from:body, every 3s{{else}}refresh from:body{{end}}">
  {{if gt .Data.ReembedPending 0}}<div class="card">Re-embedding under new settings: {{.Data.ReembedPending}} of {{.Data.ReembedTotal}} documents left</div>{{end}}
</div>
{{end}}
