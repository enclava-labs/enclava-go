{{define "frag-usage-overview"}}{{/* Overview tab (§6.12): 7/30/90 range
     chips (real links), three KPIs, server-rendered daily SVG histogram,
     spend by model/team/key. Every number derives from the named billing
     reads for the selected range; gaps in the daily series stay gaps. */}}
<div class="section" id="usage-overview">
  <div class="filters" role="group" aria-label="Date range">
    <a class="chip{{if eq .Data.Days 7}} active{{end}}" href="/dashboard/usage?range=7"{{if eq .Data.Days 7}} aria-current="page"{{end}}>7 days</a>
    <a class="chip{{if eq .Data.Days 30}} active{{end}}" href="/dashboard/usage?range=30"{{if eq .Data.Days 30}} aria-current="page"{{end}}>30 days</a>
    <a class="chip{{if eq .Data.Days 90}} active{{end}}" href="/dashboard/usage?range=90"{{if eq .Data.Days 90}} aria-current="page"{{end}}>90 days</a>
  </div>
  <div class="grid four">
    <div class="kpi">
      <div class="kpi-label">Requests · {{.Data.Days}} days</div>
      <div class="kpi-value">{{count .Data.Overview.Requests}}</div>
      <div class="kpi-foot">Settled usage records</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Tokens · {{.Data.Days}} days</div>
      <div class="kpi-value">{{count .Data.Overview.Tokens}}</div>
      <div class="kpi-foot">All unit kinds</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Spend · {{.Data.Days}} days</div>
      <div class="kpi-value" title="{{spendMicrosTitle .Data.Overview.SpendMicros .Data.Overview.SpendCurrency}}">{{if .Data.Overview.Spend}}{{spendMoney .Data.Overview.SpendMicros .Data.Overview.SpendCurrency}}{{end}}</div>
      <div class="kpi-foot">{{range .Data.Overview.SpendExtras}}<span title="{{spendMicrosTitle .AmountMicros .Currency}}">{{spendMoney .AmountMicros .Currency}}</span> {{end}}</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Unsettled</div>
      <div class="kpi-value">{{if .Data.Overview.Unsettled}}{{.Data.Overview.Unsettled}}{{else}}—{{end}}</div>
      <div class="kpi-foot">{{if .Data.Overview.UnsettledFoot}}{{.Data.Overview.UnsettledFoot}}{{else}}Held + unknown reservations{{end}}</div>
    </div>
  </div>
  <div class="card">
    <div class="section-head"><h2>Outstanding reservations</h2><a href="/dashboard/usage/reservations">View reservations</a></div>
    <p>{{.Data.Overview.HeldCount}} held · {{.Data.Overview.UnknownCount}} unknown</p>
    <p>Bound liability: {{if .Data.Overview.Outstanding}}{{range .Data.Overview.Outstanding}}<span title="{{spendMicrosTitle .AmountMicros .Currency}}">{{spendMoney .AmountMicros .Currency}}</span> {{end}}{{else}}—{{end}}</p>
  </div>
  <div class="card">
    <div class="section-head"><h2>Daily requests</h2><span class="muted">Last {{.Data.Days}} days · UTC days</span></div>
    {{if .Data.Overview.Daily}}{{bars .Data.Overview.Daily}}{{else}}<p class="muted">No settled usage in this range.</p>{{end}}
  </div>
  <div class="grid three section">
    <div class="card">
      <div class="section-head"><h2>Spend by model</h2></div>
      {{if .Data.Overview.ByModel}}
      <div class="tablewrap" role="region" tabindex="0" aria-label="Spend by model"><table>
        <thead><tr><th scope="col">Model</th><th scope="col">Requests</th><th scope="col">Units</th><th scope="col">Spend</th></tr></thead>
        <tbody>
{{range .Data.Overview.ByModel}}          <tr>
            <td data-label="Model"><b>{{.Label}}</b></td>
            <td data-label="Requests">{{count .Requests}}</td>
            <td data-label="Units">{{count .Units}}</td>
            <td data-label="Spend" title="{{spendMicrosTitle .SpendMicros .SpendCurrency}}">{{spendMoney .SpendMicros .SpendCurrency}}</td>
          </tr>
{{end}}        </tbody>
      </table></div>
      {{else}}{{template "empty" .Data.Overview.Empty}}{{end}}
    </div>
    <div class="card">
      <div class="section-head"><h2>Spend by team</h2></div>
      {{if .Data.Overview.ByTeam}}
      <div class="tablewrap" role="region" tabindex="0" aria-label="Spend by team"><table>
        <thead><tr><th scope="col">Team</th><th scope="col">Requests</th><th scope="col">Units</th><th scope="col">Spend</th></tr></thead>
        <tbody>
{{range .Data.Overview.ByTeam}}          <tr>
            <td data-label="Team"><b>{{.Label}}</b></td>
            <td data-label="Requests">{{count .Requests}}</td>
            <td data-label="Units">{{count .Units}}</td>
            <td data-label="Spend" title="{{spendMicrosTitle .SpendMicros .SpendCurrency}}">{{spendMoney .SpendMicros .SpendCurrency}}</td>
          </tr>
{{end}}        </tbody>
      </table></div>
      {{else}}{{template "empty" .Data.Overview.Empty}}{{end}}
    </div>
    <div class="card">
      <div class="section-head"><h2>Spend by subject</h2></div>
      {{if .Data.Overview.BySubject}}
      <div class="tablewrap" role="region" tabindex="0" aria-label="Spend by subject"><table>
        <thead><tr><th scope="col">Subject</th><th scope="col">Requests</th><th scope="col">Units</th><th scope="col">Spend</th><th scope="col">Unsettled</th></tr></thead>
        <tbody>
{{range .Data.Overview.BySubject}}          <tr>
            <td data-label="Subject"><b>{{.Label}}</b>{{if .Sub}}<span class="subline">{{.Sub}}</span>{{end}}</td>
            <td data-label="Requests">{{count .Requests}}</td>
            <td data-label="Units">{{count .Units}}</td>
            <td data-label="Spend" title="{{spendMicrosTitle .SpendMicros .SpendCurrency}}">{{spendMoney .SpendMicros .SpendCurrency}}</td>
            <td data-label="Unsettled">{{if .Unsettled}}{{range .Unsettled}}{{money .AmountMicros .Currency}} {{.Currency}} {{end}}{{else}}<span class="muted">—</span>{{end}}</td>
          </tr>
{{end}}        </tbody>
      </table></div>
      {{else}}{{template "empty" .Data.Overview.Empty}}{{end}}
    </div>
    <div class="card">
      <div class="section-head"><h2>Spend by key</h2></div>
      {{if .Data.Overview.ByKey}}
      <div class="tablewrap" role="region" tabindex="0" aria-label="Spend by API key"><table>
        <thead><tr><th scope="col">API key</th><th scope="col">Requests</th><th scope="col">Units</th><th scope="col">Spend</th><th scope="col">Unsettled</th></tr></thead>
        <tbody>
{{range .Data.Overview.ByKey}}          <tr>
            <td data-label="API key"><b>{{.Label}}</b>{{if .Sub}}<span class="subline">{{.Sub}}</span>{{end}}</td>
            <td data-label="Requests">{{count .Requests}}</td>
            <td data-label="Units">{{count .Units}}</td>
            <td data-label="Spend" title="{{spendMicrosTitle .SpendMicros .SpendCurrency}}">{{spendMoney .SpendMicros .SpendCurrency}}</td>
            <td data-label="Unsettled">{{if .Unsettled}}{{range .Unsettled}}{{money .AmountMicros .Currency}} {{.Currency}} {{end}}{{else}}<span class="muted">—</span>{{end}}</td>
          </tr>
{{end}}        </tbody>
      </table></div>
      {{else}}{{template "empty" .Data.Overview.Empty}}{{end}}
    </div>
  </div>
</div>
{{end}}
