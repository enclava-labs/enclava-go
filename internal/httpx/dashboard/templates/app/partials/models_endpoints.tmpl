{{define "frag-models-endpoints"}}{{/* Endpoints tab fragment — assurance
     and health render observed state only (T-09-06-01): verified needs a
     real attestation observation, unknown is never healthy, and traffic
     appears only where settled usage exists. Refresh re-fetches through the
     section's hx-get so drawer writes re-render the table. */}}
<section class="section" id="models-endpoints" hx-get="/dashboard/partials/models/endpoints" hx-trigger="refresh from:body" hx-swap="outerHTML">
  <div class="card">
    {{if .Data.Error}}<div class="attention">{{icon "alert"}}<p>{{.Data.Error}}</p></div>{{end}}
    {{if .Data.Endpoints}}
    <div class="tablewrap" role="region" tabindex="0" aria-label="Endpoints">
      <table>
        <thead>
          <tr>
            <th scope="col">Endpoint</th>
            <th scope="col">Assurance</th>
            <th scope="col">Health</th>
            <th scope="col">Models</th>
            <th scope="col">Capabilities</th>
            <th scope="col">Traffic</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {{range .Data.Endpoints}}
          <tr>
            <td data-label="Endpoint"><b>{{.ID}}</b><span class="subline">{{protocolLabel .Protocol}}{{if .Origin}} · {{.Origin}}{{end}}</span>{{if not .Enabled}}<span class="subline">Disabled</span>{{end}}</td>
            <td data-label="Assurance">
              {{if eq .AssuranceState "verified"}}{{statusPill "assurance" "verified"}}<span class="subline">TEE · checked {{relTime .AssuranceChecked}}</span>
              {{else if eq .AssuranceState "none"}}{{statusPill "assurance" "none"}}
              {{else}}{{statusPill "assurance" "unverified"}}{{if .AssuranceNote}}<span class="subline">{{.AssuranceNote}}</span>{{end}}{{end}}
            </td>
            <td data-label="Health">{{statusPill "model" .Runtime}}{{if .Latency}}<span class="subline">{{.Latency}} p50</span>{{end}}{{if .RuntimeNote}}{{$fix := dashboardErrorAction .RuntimeNote $.Can}}<span class="subline">{{if $fix.Href}}<a href="{{$fix.Href}}">{{$fix.Text}}</a>{{else}}{{$fix.Text}}{{end}}</span>{{end}}</td>
            <td data-label="Models">{{range $i, $m := .Models}}{{if $i}}, {{end}}{{$m}}{{else}}<span class="muted">—</span>{{end}}</td>
            <td data-label="Capabilities">{{if .Caps}}<div class="row">{{range .Caps}}<span class="chip">{{.}}</span>{{end}}</div>{{else}}<span class="muted">—</span>{{end}}</td>
            <td data-label="Traffic">{{if .Share}}{{.Share}}{{else}}<span class="muted">—</span>{{end}}</td>
            <td data-label="Actions"><button type="button" class="btn" data-action="models:endpoint" data-endpoint-id="{{.ID}}">Edit</button></td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else if not .Data.Error}}{{template "empty" .Data.Empty}}{{end}}
  </div>
</section>
{{end}}
