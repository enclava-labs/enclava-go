{{define "frag-sources-credentials"}}{{/* Credentials tab — access.manage only.
     Secrets are write-only: token/client-secret inputs are type=password and
     the API never returns them, so nothing secret is rendered here. Every
     write goes through Enclava.api in sources.js (data-action="creds:*");
     delete/remove ride the shared confirm group. OAuth connect is a real
     navigation to the server start route, not a fetch. */}}
<div id="sources-credentials" hx-get="/dashboard/partials/sources/credentials" hx-swap="outerHTML" hx-trigger="refresh from:body">
  {{if .Data.Connected}}<p class="pill good" role="status"><i class="dot"></i>Credential connected.</p>{{end}}
  {{if .Data.Error}}<p class="field-error" role="alert">{{.Data.Error}}</p>{{end}}
  {{if .Data.LoadError}}<p class="field-error" role="alert">Credentials could not be loaded — try refreshing the page.</p>{{end}}
  {{if not .Data.Enabled}}<div class="empty">{{icon "info"}}<p class="muted">Set ENCLAVA_SECRETS_KEY on the server to store credentials here. Environment-bound credentials still work where a source references them.</p></div>{{end}}
  {{range .Data.Cards}}
  <div class="section" data-cred-provider="{{.Provider}}">
    <div class="section-head"><h2>{{.Label}}</h2></div>
    <p class="muted">{{.Hint}}</p>
    {{range .Credentials}}    <div class="row">
      <span><b>{{.Name}}</b> {{if eq .Kind "oauth"}}<span class="pill good"><i class="dot"></i>OAuth</span>{{else}}<span class="pill neutral"><i class="dot"></i>Token</span>{{end}}{{if or (index .Details "account") (index .Details "workspace")}} <span class="muted">{{or (index .Details "account") (index .Details "workspace")}}</span>{{end}}</span>
      <span class="subline">created {{relTime .CreatedAt}} · updated {{relTime .UpdatedAt}}{{if .UsedBy}} · used by {{len .UsedBy}} source{{if ne (len .UsedBy) 1}}s{{end}}{{else}} · not used by any source{{end}}</span>
      <span class="row">
        {{if eq .Kind "token"}}<label class="visually-hidden" for="rotate-{{.ID}}">New secret for {{.Name}}</label>
        <input class="field" id="rotate-{{.ID}}" data-rotate-secret type="password" autocomplete="off" placeholder="New secret" required>
        <button type="button" class="btn" data-action="creds:rotate" data-cred-id="{{.ID}}">Save</button>{{end}}
        <button type="button" class="btn danger" data-action="confirm" data-confirm="Delete credential {{.Name}}?" data-cred-del="1" data-cred-id="{{.ID}}">Delete</button>
      </span>
    </div>
    {{else}}    <p class="muted">No stored credentials.</p>
    {{end}}
    {{range .EnvRefs}}    <div class="row"><code>{{.}}</code><span class="subline">from server configuration</span></div>
    {{end}}
    {{if $.Data.Enabled}}
    <h3>Add a token or secret</h3>
    <div class="stack">
      <label class="label" for="add-name-{{.Provider}}">Name</label>
      <input class="field" id="add-name-{{.Provider}}" data-add-name autocomplete="off" required>
      <label class="label" for="add-secret-{{.Provider}}">Secret</label>
      <input class="field" id="add-secret-{{.Provider}}" data-add-secret type="password" autocomplete="off" required>
      <details{{if eq .Provider "jira"}} open{{end}}>
        <summary>{{if eq .Provider "jira"}}Site{{else}}Advanced{{end}}</summary>
        <label class="label" for="add-origin-{{.Provider}}">{{if eq .Provider "jira"}}Site URL (required, e.g. https://acme.atlassian.net){{else}}API origin (e.g. GitHub Enterprise){{end}}</label>
        <input class="field" id="add-origin-{{.Provider}}" data-add-origin autocomplete="off" placeholder="{{if eq .Provider "jira"}}https://acme.atlassian.net{{else}}Leave empty for the default{{end}}">
      </details>
      <span class="field-error" data-creds-error hidden></span>
      <div class="row"><button type="button" class="btn primary" data-action="creds:add" data-provider="{{.Provider}}">Add token</button></div>
    </div>
    {{if .OAuthSupported}}
    <h3>OAuth sign-in</h3>
    <div class="stack">
      {{if .OAuthRedirectURI}}<p class="help">Register this redirect URI at {{.Label}}: <code>{{.OAuthRedirectURI}}</code></p>{{else}}<p class="help">OAuth sign-in needs PUBLIC_BASE_URL set on the server before a redirect URI can be issued.</p>{{end}}
      {{if .OAuthConfigured}}<p class="help">OAuth app configured — client ID <code>{{.OAuthClientID}}</code>.</p>{{end}}
      <label class="label" for="oauth-cid-{{.Provider}}">Client ID</label>
      <input class="field" id="oauth-cid-{{.Provider}}" data-oauth-client-id autocomplete="off"{{if .OAuthClientID}} value="{{.OAuthClientID}}"{{end}} required>
      <label class="label" for="oauth-csecret-{{.Provider}}">Client secret</label>
      <input class="field" id="oauth-csecret-{{.Provider}}" data-oauth-client-secret type="password" autocomplete="off" required>
      <span class="field-error" data-creds-error hidden></span>
      <div class="row">
        <button type="button" class="btn" data-action="creds:oauth-save" data-provider="{{.Provider}}">Save OAuth app</button>
        {{if .OAuthConfigured}}<button type="button" class="btn danger" data-action="confirm" data-confirm="Remove the {{.Label}} OAuth app? Connected credentials stay but new OAuth sign-ins stop working." data-oauth-del="1" data-provider="{{.Provider}}">Remove</button>{{end}}
      </div>
      {{if .CanConnect}}<div class="row">
        <label class="label visually-hidden" for="connect-name-{{.Provider}}">Name for the connected credential</label>
        <input class="field" id="connect-name-{{.Provider}}" data-connect-name autocomplete="off" placeholder="Credential name" required>
        <button type="button" class="btn primary" data-action="creds:connect" data-provider="{{.Provider}}">Connect with {{.Label}}</button>
      </div>
      <span class="field-error" data-creds-error hidden></span>{{end}}
    </div>
    {{end}}
    {{end}}
  </div>
  {{end}}
</div>
{{end}}