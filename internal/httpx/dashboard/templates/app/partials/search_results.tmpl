{{define "frag-search-results"}}{{/* The §6.4 Search component — the SINGLE
     result renderer (D-24): embedded in pages/search.tmpl, served to htmx at
     /dashboard/partials/search/results, and consumed scoped via collection=
     by 09-01's collection Search tab. Facets are the post-authorization
     payload; snippets render through the phase-7 escape-then-mark func. */}}
{{if .Data.Results}}
  {{with .Data.Results}}
    {{if .Error}}<p class="field-error">{{.Error}}</p>{{if .Hint}}<p class="muted">{{.Hint}}</p>{{end}}{{end}}
    {{if .Facets}}<div class="filters" role="group" aria-label="Filter by source">
      <button type="button" class="chip active" data-facet="" aria-pressed="true">All</button>
      {{range .Facets}}<button type="button" class="chip" data-facet="{{.SourceKind}}" aria-pressed="false">{{term .SourceKind}} · {{count .Count}}</button>{{end}}
    </div>{{end}}
    {{if .Rows}}
    <div id="searchResultRows">
    {{range .Rows}}
    <div class="result" data-source-kind="{{.SourceKind}}">
      <div class="row">
        <span style="flex:1" class="result-title">{{.Title}}</span>
        <span class="muted">{{icon "file"}} {{term .SourceKind}}</span>
      </div>
      <div class="result-meta">{{.Collection}}{{if .Location}} · {{.Location}}{{end}}</div>
      <div class="result-snippet">{{mark .Content $.Data.Query}}</div>
      {{if .EvidenceID}}<div class="row" style="margin-top:8px">
        <button type="button" class="btn" data-action="evidence:open" data-evidence-id="{{.EvidenceID}}">View evidence</button>
        <a class="btn ghost" data-action="search:ask-about" data-evidence-id="{{.EvidenceID}}" href="/dashboard/chat?evidence={{urlquery .EvidenceID}}">Ask about this</a>
      </div>{{end}}
    </div>
    {{end}}
    {{if .NextCursor}}<div class="row" id="searchMoreRow" style="margin-top:12px">
      {{/* Same fragment, cursor-paged: only new rows (and a fresh control,
          while the pool has more) are selected into #searchResultRows — the
          facets stay the first page's post-authorization payload. search.js
          drops the clicked control on the successful request. */}}
      <button type="button" class="btn" data-search-more
        hx-get="/dashboard/partials/search/results?q={{urlquery $.Data.Query}}&mode={{$.Data.Mode}}&cursor={{urlquery .NextCursor}}{{if $.Data.Collection}}&collection={{$.Data.Collection}}{{end}}"
        hx-target="#searchResultRows" hx-swap="beforeend" hx-select=".result, #searchMoreRow" hx-push-url="false">More results</button>
    </div>{{end}}
    </div>
    {{else}}
    {{if not .Error}}{{template "empty" $.Data.ResultsEmpty}}{{end}}
    {{end}}
  {{end}}
{{else}}
  <div id="searchRecents"></div>
  {{if .Data.Collections}}
  <div class="section-head"><h2>Your collections</h2></div>
  <div class="grid two">
    {{range .Data.Collections}}<a class="card" href="/dashboard/search?collection={{urlquery .ID}}"><b>{{.Name}}</b>{{if .Description}}<span class="muted">{{.Description}}</span>{{end}}</a>{{end}}
  </div>
  {{else}}
  {{template "empty" .Data.CollectionsEmpty}}
  {{end}}
{{end}}
{{end}}
