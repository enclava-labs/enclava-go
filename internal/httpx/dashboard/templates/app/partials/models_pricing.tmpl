{{define "frag-models-pricing"}}{{/* Pricing matrix (OA-27): one row per
     model @ endpoint binding and priced capability the endpoint advertises,
     columns Input / Cached input / Output per 1M tokens. Unpriced required
     cells carry the exact refusal copy; one row-level Set price control
     opens a single form for all three categories (P-05) that saves the
     entered units atomically through the pricing batch write. Cells carry
     their stored rate as data-* so the form prefills the set the row shows
     (the coverage rule is whole-set — never a per-unit merge).
     data-price-row/data-price-cell hook the browser spec and refresh swaps. */}}
<section class="section" id="models-pricing" hx-get="/dashboard/partials/models/pricing" hx-trigger="refresh from:body" hx-swap="outerHTML">
  <div class="card">
    {{if .Data.Error}}<div class="attention">{{icon "alert"}}<p>{{.Data.Error}}</p></div>{{end}}
    {{if .Data.Rows}}
    <div class="tablewrap" role="region" tabindex="0" aria-label="Pricing">
      <table>
        <thead>
          <tr>
            <th scope="col">Model @ endpoint</th>
            <th scope="col">Input</th>
            <th scope="col">Cached input</th>
            <th scope="col">Output</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {{range .Data.Rows}}
          <tr data-price-row="{{.EndpointID}}|{{.Model}}|{{.Capability}}">
            <td data-label="Model @ endpoint"><b>{{.Model}}</b><span class="subline">{{.CapabilityLabel}} · @{{.EndpointID}}{{if .Upstream}} → {{.Upstream}}{{end}}</span></td>
            {{$row := .}}
            {{range .Cells}}
            <td data-label="{{.UnitLabel}}" data-price-cell="{{$row.EndpointID}}|{{.Unit}}"{{if .Priced}} data-rate-micros="{{.RateMicros}}" data-unit-quantity="{{.UnitQuantity}}" data-currency="{{.Currency}}"{{end}}>
              {{if .Priced}}<b>{{tokenPrice .RateMicros .UnitQuantity .Currency}}</b><span class="subline">per 1,000,000 tokens · via {{$row.Basis}}</span>
              {{else if .Required}}<span class="price-warning">{{.UnitLabel}} not priced — requests refused</span>
              {{else}}<span class="muted">{{.UnitLabel}} not priced</span>{{end}}
            </td>
            {{end}}
            <td data-label="Actions"><button type="button" class="btn{{if not .Unpriced}} ghost{{end}}" data-action="models:price"
              data-endpoint="{{.EndpointID}}" data-model="{{.Model}}" data-capability="{{.Capability}}"
              data-subject-type="{{.Basis}}" data-subject-id="{{.SubjectID}}">{{if .Unpriced}}Set price{{else}}Change prices{{end}}</button>
              <button type="button" class="btn ghost" data-action="models:history"
              data-endpoint="{{.EndpointID}}" data-model="{{.Model}}" data-capability="{{.Capability}}">History</button></td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else if not .Data.Error}}{{template "empty" .Data.Empty}}{{end}}
  </div>
</section>
{{end}}
