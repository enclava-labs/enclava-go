{{define "frag-access-roles"}}{{/* Roles tab (09-07): member counts and
     scopes as plain-word capabilities. Edit opens the role editor; delete
     surfaces the API's 409 role_has_members instead of failing silently. */}}
<div id="access-roles" hx-get="/dashboard/partials/access/roles" hx-trigger="refresh from:body" hx-target="this" hx-swap="outerHTML">
{{if .Data.Roles}}  <div class="card">
    <div class="tablewrap" role="region" tabindex="0" aria-label="Roles">
      <table>
        <thead>
          <tr>
            <th scope="col">Role</th>
            <th scope="col">Members</th>
            <th scope="col">Capabilities</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
{{range .Data.Roles}}          <tr>
            <td data-label="Role"><b>{{.Name}}</b></td>
            <td data-label="Members">{{count .Members}}</td>
            <td data-label="Capabilities">{{if .ScopeLabels}}{{range $i, $l := .ScopeLabels}}{{if $i}} · {{end}}{{$l}}{{end}}{{else}}<span class="muted">No capabilities</span>{{end}}</td>
            <td data-label="Actions">
              <div class="row">
                <button type="button" class="btn" data-action="open-drawer" data-drawer-url="/dashboard/partials/access/role-editor?id={{.ID}}">{{icon "settings"}}Edit</button>
                <button type="button" class="btn danger" data-action="confirm" data-confirm="Delete role {{.Name}}?" data-access-confirm="role-delete" data-role-id="{{.ID}}">Delete</button>
              </div>
            </td>
          </tr>
{{end}}        </tbody>
      </table>
    </div>
  </div>
{{else}}  {{template "empty" .Data.RolesEmpty}}
{{end}}</div>
{{end}}
