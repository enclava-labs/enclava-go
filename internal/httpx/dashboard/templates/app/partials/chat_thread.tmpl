{{define "frag-chat-thread"}}{{/* The conversation body: server-rendered
     messages, per-turn collapsible tool steps, pending-run markers and
     terminal run lines. The root re-fetches on `refresh from:body` and
     adds `every 3s` only while a run is non-terminal; chat.js's run
     poller (Enclava.POLL_MS) calls Enclava.refresh() at terminal.
     Assistant bubbles carry plain text — chat.js renders the safe
     Markdown subset and binds [n]/evidence_<id> citation buttons from
     data-evidence-ids (DOM nodes only, never innerHTML). */}}
<div class="thread-body" id="chatThread" data-scroll-latest{{if and .Data.Thread .Data.Thread.HasKnowledge}} data-has-knowledge="1"{{end}}
  {{if .Data.ConversationID}}hx-get="/dashboard/partials/chat/thread?c={{urlquery .Data.ConversationID}}"
     hx-trigger="refresh from:body{{if and .Data.Thread .Data.Thread.Live}}, every 3s{{end}}" hx-target="this" hx-swap="outerHTML"{{end}}>
  {{if .Data.Thread}}
    {{range .Data.Thread.Messages}}
    <article class="message{{if eq .Role "user"}} user{{else}} assistant{{end}}"{{if .EvidAttr}} data-evidence-ids="{{.EvidAttr}}"{{end}}{{if .RunID}} data-run-id="{{.RunID}}"{{if .RunStatus}} data-run-status="{{.RunStatus}}"{{end}}{{end}}>
      <div class="author">{{.Author}} · {{relTime .CreatedAt}}</div>
      {{if .Steps}}<details class="toolstep">
        <summary>{{icon "check"}} {{len .Steps}} tool {{if eq (len .Steps) 1}}step{{else}}steps{{end}}</summary>
        {{range .Steps}}<div class="steprow"><b>{{.Name}}</b> <span class="muted">{{term .Kind}}</span> {{statusPill "job" .Status}}{{if and (eq .Kind "model") .Input}}<span class="muted stepnote">{{.Input}}</span>{{end}}{{if .Error}}<span class="muted stepnote">{{.Error}}</span>{{end}}{{if .Output}}<span class="muted stepnote">{{.Output}}</span>{{end}}</div>{{end}}
      </details>{{end}}
      {{if .Content}}<div class="bubble">{{.Content}}</div>{{end}}
      {{if and .RunID (not .Pending) (ne .Role "user")}}
        {{if eq .RunStatus "cancelled"}}<div class="runline muted">{{statusPill "job" .RunStatus}} Stopped by you</div>
        {{else if eq .RunStatus "unknown"}}<div class="runline muted">{{statusPill "job" .RunStatus}}{{if .RunError}} {{.RunError}}{{else}} Worker outcome unknown; this attempt will not be repeated.{{end}}</div>
        {{else if eq .RunStatus "failed"}}{{$fix := dashboardErrorAction .RunError $.Can}}<div class="runline muted">{{statusPill "job" .RunStatus}}{{if $fix.Text}} {{$fix.Text}}{{else}} This run failed.{{end}}{{if $fix.Href}} <a href="{{$fix.Href}}">{{$fix.Label}}</a>{{end}}</div>
        {{end}}
      {{end}}
      {{if and .Pending (eq .Role "user")}}
        <div class="runline"><span class="pulse" aria-hidden="true">●</span>{{statusPill "job" .RunStatus}}
          <button type="button" class="btn danger" data-action="confirm" data-confirm="Stop run?" data-run-id="{{.RunID}}">{{icon "stop"}} Stop</button>
        </div>
      {{end}}
    </article>
    {{end}}
  {{else}}
    {{template "empty" .Data.ThreadEmpty}}
  {{end}}
</div>
{{end}}
