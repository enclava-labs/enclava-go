{{define "frag-access-service-accounts"}}{{/* Service accounts tab (09-07):
     real list + inline create form (scopes ⊆ caller's, enforced again by the
     API) + disable via PATCH …/service-accounts/{id}. */}}
<div id="access-service-accounts" hx-get="/dashboard/partials/access/service-accounts" hx-trigger="refresh from:body" hx-target="this" hx-swap="outerHTML">
  <div class="stack">
{{if .Data.Accounts}}    <div class="card">
      <div class="tablewrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Service account</th>
              <th scope="col">Status</th>
              <th scope="col">Created</th>
              <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody>
{{range .Data.Accounts}}            <tr>
              <td data-label="Service account"><b>{{.Name}}</b></td>
              <td data-label="Status">{{statusPill "member" .Status}}</td>
              <td data-label="Created">{{relTime .Created}}</td>
              <td data-label="Actions">{{if ne .Status "disabled"}}<button type="button" class="btn danger" data-action="confirm" data-confirm="Disable service account {{.Name}}? Its keys stop working." data-access-confirm="sa-disable" data-sa-id="{{.ID}}">Disable</button>{{else}}<span class="muted">—</span>{{end}}</td>
            </tr>
{{end}}          </tbody>
        </table>
      </div>
    </div>
{{else}}    {{template "empty" .Data.AccountsEmpty}}
{{end}}    <div class="card">
      <div class="card-title">New service account</div>
      <form data-form="access-sa">
        <div class="grid two">
          <div>
            <label class="label" for="access-sa-name">Name</label>
            <input class="field" id="access-sa-name" name="name" required autocomplete="off">
            <span class="help">Scopes are a subset of your own — the API refuses anything wider.</span>
          </div>
        </div>
        <fieldset class="stack">
          <legend class="label">Capabilities</legend>
{{range .Data.AccountForm}}          <label class="row"><input type="checkbox" name="scope" value="{{.Scope}}"> {{.Label}}</label>
{{end}}        </fieldset>
        <div class="row">
          <button type="submit" class="btn primary">{{icon "plus"}}Create service account</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{end}}
