{{define "frag-access-sign-in"}}{{/* Sign-in tab (09-07): configured OIDC
     providers rendered strictly read-only — provider management is
     configuration-driven and no write UI exists (excluded feature). Zero form
     controls by design. */}}
<div id="access-sign-in" hx-get="/dashboard/partials/access/sign-in" hx-trigger="refresh from:body" hx-target="this" hx-swap="outerHTML">
{{if .Data.Providers}}  <div class="card">
    <div class="tablewrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Provider</th>
            <th scope="col">Issuer</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
{{range .Data.Providers}}          <tr>
            <td data-label="Provider"><b>{{.Name}}</b></td>
            <td data-label="Issuer"><span class="subline">{{.Issuer}}</span></td>
            <td data-label="Status">{{statusPill "member" "active"}}</td>
          </tr>
{{end}}        </tbody>
      </table>
    </div>
    <p class="help">Sign-in providers are configuration-driven — adding or changing them is a deployment configuration change, not a dashboard action.</p>
  </div>
{{else}}  <div class="empty">{{icon "link"}}<p>No sign-in providers configured.</p></div>
  <p class="help">Single sign-on providers come from deployment configuration; employees can also link a provider from Account after signing in.</p>
{{end}}</div>
{{end}}
