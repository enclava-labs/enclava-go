{{define "frag-sources-drawer"}}{{/* Add-source wizard (OA-23, plan 09-02):
     five steps, provider-conditional fields, credential refs filtered
     server-side per provider. Markup only (D-20) — static/pages/sources.js
     drives every interaction via data-action delegation and writes through
     Enclava.api (D-17). */}}
{{if .Data.EditSource}}
<div class="drawer-head">
  <h2>Reconnect {{.Data.EditSource.Name}}</h2>
  <button type="button" class="iconbtn" data-action="close-drawer" aria-label="Close drawer">{{icon "x"}}</button>
</div>
<div class="section" data-source-edit="{{.Data.EditSource.ID}}">
  <h3>Connect</h3>
  <label class="label" for="source-edit-credential">Credential reference</label>
  <input class="field" id="source-edit-credential" data-edit-credential list="source-edit-credentials" value="{{.Data.EditSource.CredentialRef}}" autocomplete="off">
  <datalist id="source-edit-credentials">{{range index .Data.CredentialRefs .Data.EditSource.Type}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
  <p class="help">Choose the credential used to connect this source.</p>
  <button type="button" class="btn primary" data-action="sources:save-credential">Save connection</button>
</div>
{{else}}
<div class="drawer-head">
  <h2>Add source</h2>
  <button type="button" class="iconbtn" data-action="close-drawer" aria-label="Close drawer">{{icon "x"}}<span class="visually-hidden">Close</span></button>
</div>
<div class="stepper" aria-label="Add source steps">
  <span class="step active" data-step-dot="1" aria-current="step">1 Provider</span>
  <span class="step" data-step-dot="2">2 Connect</span>
  <span class="step" data-step-dot="3">3 Access</span>
  <span class="step" data-step-dot="4">4 Destination</span>
  <span class="step" data-step-dot="5">5 Review</span>
</div>

<div class="section" data-step-pane="1">
  <div class="tilegrid">
    <button type="button" class="tile" data-action="sources:provider" data-provider="slack" aria-pressed="false">{{icon "chat"}}<b>Slack</b><span class="subline">Channel messages</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="teams" aria-pressed="false">{{icon "users"}}<b>Microsoft Teams</b><span class="subline">Channels and chats</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="github" aria-pressed="false">{{icon "command"}}<b>GitHub</b><span class="subline">Repository files</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="gitlab" aria-pressed="false">{{icon "command"}}<b>GitLab</b><span class="subline">Repository, issues and merge requests</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="jira" aria-pressed="false">{{icon "audit"}}<b>Jira</b><span class="subline">Project issues</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="linear" aria-pressed="false">{{icon "activity"}}<b>Linear</b><span class="subline">Team issues</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="notion" aria-pressed="false">{{icon "file"}}<b>Notion</b><span class="subline">Pages and subpages</span></button>
    <button type="button" class="tile" data-action="sources:provider" data-provider="google_drive" aria-pressed="false">{{icon "upload"}}<b>Google Drive</b><span class="subline">Shared folders</span></button>
  </div>
  <span class="field-error" data-wizard-error hidden></span>
</div>

<div class="section" data-step-pane="2" hidden>
  <div class="section-head"><h2>Connect and scope</h2></div>

  <div data-provider-fields="slack" hidden>
    <label class="label" for="slack-credential">Credential reference</label>
    <input class="field" id="slack-credential" data-credential list="cred-slack" autocomplete="off" required>
    <datalist id="cred-slack">{{range index .Data.CredentialRefs "slack"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "slack")}}<span class="help">No Slack credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_SLACK_* secret in server configuration.</span>{{end}}
    <label class="label" for="slack-channel">Channel</label>
    <select class="field" id="slack-channel" data-config="channel_id" data-slack-channels>
      <option value="">All channels the credential is a member of</option>
    </select>
    <span class="help" data-slack-channels-status>Choose a credential to list its channels — the bot only sees channels it was invited to.</span>
    <label class="label" for="slack-limit">Item limit</label>
    <input class="field" id="slack-limit" data-config="limit" data-type="number" type="number" min="1" inputmode="numeric">
    <label class="label"><input type="checkbox" data-config="reconcile" data-type="bool" value="true"> Reconcile access on every sync</label>
  </div>

  <div data-provider-fields="teams" hidden>
    <label class="label" for="teams-tenant">Tenant ID</label>
    <input class="field" id="teams-tenant" data-config="tenant_id" autocomplete="off">
    <label class="label" for="teams-client">Client ID</label>
    <input class="field" id="teams-client" data-config="client_id" autocomplete="off">
    <span class="help">Tenant and client IDs are required together for app-only access.</span>
    <label class="label" for="teams-team">Team ID(s)</label>
    <input class="field" id="teams-team" data-team-scope required>
    <span class="help">One team ID, or several separated by commas.</span>
    <label class="label" for="teams-channels">Channel restrictions</label>
    <textarea class="field" id="teams-channels" data-channels rows="2" placeholder="team-id:channel-id"></textarea>
    <span class="help">One team-id:channel-id pair per line to sync only those channels; empty syncs every channel of the selected teams.</span>
    <label class="label" for="teams-chats">Chat IDs</label>
    <textarea class="field" id="teams-chats" data-config="chat_ids" data-type="list" rows="2" placeholder="chat-id per line"></textarea>
    <span class="help">Optional — chat-backed content outside any team.</span>
    <label class="label" for="teams-graph">Graph base URL</label>
    <input class="field" id="teams-graph" data-config="graph_base_url" autocomplete="off" placeholder="https://graph.microsoft.com/v1.0">
    <label class="label" for="teams-credential">Credential reference</label>
    <input class="field" id="teams-credential" data-credential list="cred-teams" autocomplete="off" required>
    <datalist id="cred-teams">{{range index .Data.CredentialRefs "teams"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "teams")}}<span class="help">No Teams credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_TEAMS_* secret in server configuration.</span>{{end}}
  </div>

  <div data-provider-fields="github" hidden>
    <label class="label" for="github-owner">Owner</label>
    <input class="field" id="github-owner" data-config="owner" required>
    <label class="label" for="github-repo">Repository</label>
    <input class="field" id="github-repo" data-config="repo" required>
    <label class="label" for="github-ref">Ref</label>
    <input class="field" id="github-ref" data-config="ref" placeholder="HEAD">
    <label class="label" for="github-paths">Paths</label>
    <textarea class="field" id="github-paths" data-config="paths" data-type="list" rows="2" placeholder="docs/ per line"></textarea>
    <span class="help">Optional — restrict the sync to these repository paths.</span>
    <label class="label" for="github-api">API URL</label>
    <input class="field" id="github-api" data-config="api_url" autocomplete="off" placeholder="https://api.github.com">
    <label class="label" for="github-credential">Credential reference</label>
    <input class="field" id="github-credential" data-credential list="cred-github" autocomplete="off">
    <datalist id="cred-github">{{range index .Data.CredentialRefs "github"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    <span class="help">Public repository content can sync without a credential. Manage stored credentials in <a href="/dashboard/sources/credentials">Credentials</a>.</span>
  </div>

  <div data-provider-fields="gitlab" hidden>
    <label class="label" for="gitlab-project">Project</label>
    <input class="field" id="gitlab-project" data-config="project" placeholder="group/project" required>
    <label class="label" for="gitlab-ref">Branch</label>
    <input class="field" id="gitlab-ref" data-config="ref" placeholder="Default branch">
    <label class="label" for="gitlab-paths">Paths</label>
    <textarea class="field" id="gitlab-paths" data-config="paths" data-type="list" rows="2" placeholder="docs/ per line"></textarea>
    <span class="help">Optional — restrict file sync to these repository paths. Issues and merge requests always sync.</span>
    <label class="label" for="gitlab-base">GitLab URL</label>
    <input class="field" id="gitlab-base" data-config="base_url" autocomplete="off" placeholder="https://gitlab.com">
    <label class="label" for="gitlab-credential">Credential reference</label>
    <input class="field" id="gitlab-credential" data-credential list="cred-gitlab" autocomplete="off">
    <datalist id="cred-gitlab">{{range index .Data.CredentialRefs "gitlab"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    <span class="help">Public projects can sync without a credential. Manage stored credentials in <a href="/dashboard/sources/credentials">Credentials</a>.</span>
  </div>

  <div data-provider-fields="jira" hidden>
    <label class="label" for="jira-site">Site URL</label>
    <input class="field" id="jira-site" data-config="base_url" autocomplete="off" placeholder="https://acme.atlassian.net" required>
    <label class="label" for="jira-project">Project key</label>
    <input class="field" id="jira-project" data-config="project" placeholder="ENG" required>
    <label class="label" for="jira-credential">Credential reference</label>
    <input class="field" id="jira-credential" data-credential list="cred-jira" autocomplete="off" required>
    <datalist id="cred-jira">{{range index .Data.CredentialRefs "jira"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "jira")}}<span class="help">No Jira credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_JIRA_* secret in server configuration.</span>{{end}}
  </div>

  <div data-provider-fields="linear" hidden>
    <label class="label" for="linear-teams">Team keys</label>
    <input class="field" id="linear-teams" data-config="team_keys" data-type="list" autocomplete="off" placeholder="ENG, OPS">
    <span class="help">Optional — empty syncs every team the key can see.</span>
    <label class="label" for="linear-credential">Credential reference</label>
    <input class="field" id="linear-credential" data-credential list="cred-linear" autocomplete="off" required>
    <datalist id="cred-linear">{{range index .Data.CredentialRefs "linear"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "linear")}}<span class="help">No Linear credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_LINEAR_* secret in server configuration.</span>{{end}}
  </div>

  <div data-provider-fields="notion" hidden>
    <label class="label" for="notion-pages">Page IDs</label>
    <textarea class="field" id="notion-pages" data-notion-pages rows="2" placeholder="page id per line" required></textarea>
    <span class="help">Each selected page syncs into the target collection.</span>
    <label class="label" for="notion-depth">Max depth</label>
    <input class="field" id="notion-depth" data-config="max_depth" data-type="number" type="number" min="1" max="8" inputmode="numeric" placeholder="3">
    <label class="label" for="notion-max-pages">Max pages</label>
    <input class="field" id="notion-max-pages" data-config="max_pages" data-type="number" type="number" min="1" max="500" inputmode="numeric" placeholder="50">
    <label class="label" for="notion-version">Notion version</label>
    <input class="field" id="notion-version" data-config="notion_version" placeholder="2022-06-28">
    <label class="label" for="notion-base">Base URL</label>
    <input class="field" id="notion-base" data-config="base_url" autocomplete="off" placeholder="https://api.notion.com/v1">
    <label class="label" for="notion-credential">Credential reference</label>
    <input class="field" id="notion-credential" data-credential list="cred-notion" autocomplete="off" required>
    <datalist id="cred-notion">{{range index .Data.CredentialRefs "notion"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "notion")}}<span class="help">No Notion credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_NOTION_* secret in server configuration.</span>{{end}}
  </div>

  <div data-provider-fields="google_drive" hidden>
    <label class="label" for="drive-folder">Folder ID</label>
    <input class="field" id="drive-folder" data-config="folder_id" required>
    <label class="label" for="drive-shared">Shared drive ID</label>
    <input class="field" id="drive-shared" data-config="shared_drive_id" autocomplete="off">
    <label class="label" for="drive-mimes">MIME types</label>
    <textarea class="field" id="drive-mimes" data-config="mime_types" data-type="list" rows="2" placeholder="application/pdf per line"></textarea>
    <span class="help">Optional — restrict the sync to these file types.</span>
    <label class="label" for="drive-base">Base URL</label>
    <input class="field" id="drive-base" data-config="base_url" autocomplete="off" placeholder="https://www.googleapis.com/drive/v3">
    <label class="label" for="drive-sheets">Sheets base URL</label>
    <input class="field" id="drive-sheets" data-config="sheets_base_url" autocomplete="off" placeholder="https://sheets.googleapis.com/v4">
    <label class="label" for="drive-credential">Credential reference</label>
    <input class="field" id="drive-credential" data-credential list="cred-google_drive" autocomplete="off" required>
    <datalist id="cred-google_drive">{{range index .Data.CredentialRefs "google_drive"}}<option value="{{.RefID}}">{{.Name}}</option>{{end}}</datalist>
    {{if not (index .Data.CredentialRefs "google_drive")}}<span class="help">No Google Drive credentials configured — <a href="/dashboard/sources/credentials">add one in Credentials</a> or bind a CONNECTOR_GOOGLE_DRIVE_* secret in server configuration.</span>{{end}}
  </div>
  <span class="field-error" data-wizard-error hidden></span>
</div>

<div class="section" data-step-pane="3" hidden>
  <div class="section-head"><h2>Access</h2></div>
  <div data-provider-access="slack" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="teams" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="github" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="gitlab" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="jira" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="linear" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="notion" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs.</p>
  </div>
  <div data-provider-access="google_drive" hidden>
    <p class="muted">Everyone who can open the target collection can read everything this source syncs. Drive files that readers cannot copy or download are not synced.</p>
  </div>
</div>

<div class="section" data-step-pane="4" hidden>
  <div class="section-head"><h2>Destination and schedule</h2></div>
  <label class="label" for="source-name">Source name</label>
  <input class="field" id="source-name" data-source-name required>
  <label class="label" for="source-collection">Target collection</label>
  <select class="field" id="source-collection" data-source-collection required>
    <option value="" disabled{{if not .Data.Collections}} selected{{end}}>Choose a collection</option>
    {{range .Data.Collections}}<option value="{{.ID}}"{{if eq .ID $.Data.PresetCollection}} selected{{end}}>{{.Name}}</option>{{end}}
  </select>
  {{if not .Data.Collections}}<span class="help">No writable collections — create one in Knowledge first.</span>{{end}}
  <label class="label" for="source-interval">Sync interval</label>
  <input class="field" id="source-interval" data-source-interval placeholder="30m" autocomplete="off">
  <span class="help">e.g. 30m, 6h, 24h — empty uses the 1h default; 0 disables scheduled syncs. Minimum 5m.</span>
  <label class="label"><input type="checkbox" id="source-enabled" data-source-enabled checked> Enabled</label>
  <span class="field-error" data-wizard-error hidden></span>
</div>

<div class="section" data-step-pane="5" hidden>
  <div class="section-head"><h2>Review</h2></div>
  <div class="stack" id="source-review" data-source-review></div>
  <p class="muted">Creating the source starts its first sync immediately.</p>
  <span class="field-error" data-wizard-error hidden></span>
</div>

<div class="drawer-actions">
  <button type="button" class="btn ghost" data-action="sources:back" disabled>Back</button>
  <button type="button" class="btn primary" data-action="sources:next" disabled>Continue</button>
  <button type="button" class="btn primary" data-action="sources:submit" hidden>Create source and sync</button>
</div>
{{end}}
{{end}}

