{{define "frag-knowledge-collections"}}{{/* Collections table (OA-22). Served
     by GET /dashboard/partials/knowledge/collections and rendered inline.
     §3.4 split: members get Collection / Documents / Updated ONLY — every
     Health, Sources and Access cell is behind .Can.KnowledgeManage so member
     markup cannot contain them. */}}
<div id="knowledge-collections" hx-get="/dashboard/partials/knowledge/collections" hx-swap="outerHTML" hx-trigger="refresh from:body">
{{if .Data.Rows}}  <div class="tablewrap" role="region" tabindex="0" aria-label="Collections">
    <table>
      <thead>
        <tr>
          <th scope="col">Collection</th>
          <th scope="col">Documents</th>
          <th scope="col">Updated</th>
{{if $.Can.KnowledgeManage}}          <th scope="col">Health</th>
          <th scope="col">Sources</th>
          <th scope="col">Access</th>
{{end}}        </tr>
      </thead>
      <tbody>
{{range .Data.Rows}}        <tr>
          <td data-label="Collection"><a href="/dashboard/knowledge/{{.Collection.ID}}"><b>{{.Collection.Name}}</b></a>{{if .Collection.Description}}<span class="subline">{{.Collection.Description}}</span>{{end}}</td>
          <td data-label="Documents">{{count .DocCount}}{{if .DocMore}}+{{end}}</td>
          <td data-label="Updated">{{relTime .LastUpdate}}</td>
{{if $.Can.KnowledgeManage}}          <td data-label="Health">{{statusPill "collection" .Health}}</td>
          <td data-label="Sources">{{count .Sources}}</td>
          <td data-label="Access">{{.Access}}</td>
{{end}}        </tr>
{{end}}      </tbody>
    </table>
  </div>
{{else}}{{template "empty" .Data.Empty}}
{{end}}</div>
{{end}}
