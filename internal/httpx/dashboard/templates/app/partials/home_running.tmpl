{{define "frag-running"}}{{/* Running now (OA-18): self-replacing fragment per
     the phase-7 partial convention. The 3s trigger renders only while
     non-terminal items exist; progress bars only when the stored worker
     progress carries real counts — otherwise the indeterminate .pulse. */}}
<div id="homeRunning" hx-get="/dashboard/partials/home/running" hx-trigger="refresh from:body{{if .Data.Running.Live}}, every 3s{{end}}" hx-target="this" hx-swap="outerHTML">
  {{if .Data.Running.Rows}}
  <div class="stack">
  {{range .Data.Running.Rows}}
    <div class="activity-row">
      <span class="activity-icon">{{icon "activity"}}</span>
      <div class="activity-copy">
        <div>{{.Label}}</div>
        <span class="muted">{{relTime .UpdatedAt}}</span>
      </div>
      {{if .HasPercent}}<span class="progress"><i style="width: {{.Percent}}%"></i></span>{{else if .Live}}<span class="pulse" aria-hidden="true"></span>{{end}}
      {{statusPill "job" .Status}}
      {{if .Href}}<a class="btn ghost" href="{{.Href}}">Open</a>{{end}}
    </div>
  {{end}}
  </div>
  {{else}}{{template "empty" .Data.Running.Empty}}{{end}}
</div>{{end}}

{{define "frag-attention"}}{{/* Needs-attention rows carry the shared
     error→next-step map (Fix*); the 3s trigger lives only while a row's
     underlying work is non-terminal (a syncing source). */}}
<div id="homeAttentionList" hx-get="/dashboard/partials/home/attention" hx-trigger="refresh from:body{{if .Data.AttentionLive}}, every 3s{{end}}" hx-target="this" hx-swap="outerHTML">
  {{if .Data.Attention}}
  <div class="stack">
  {{range .Data.Attention}}
    <div class="attention">
      <span class="activity-icon">{{icon "bell"}}</span>
      <div class="activity-copy"><div>{{.Text}}</div>{{if .FixText}}<span class="subline">{{.FixText}}</span>{{end}}</div>
      {{if .FixHref}}<a class="btn ghost" href="{{.FixHref}}">{{.FixLabel}}</a>{{else if .ActionHref}}<a class="btn ghost" href="{{.ActionHref}}">{{.ActionLabel}}</a>{{end}}
      {{if .DismissURL}}<button type="button" class="btn ghost" data-action="confirm" data-confirm="Dismiss this API access request? No access will be granted." data-dismiss-url="{{.DismissURL}}">Dismiss</button>{{end}}
    </div>
  {{end}}
  </div>
  {{else}}{{template "empty" .Data.AttentionEmpty}}{{end}}
</div>
{{end}}
