    <button type="button" class="btn primary" data-action="open-drawer" data-drawer-url="/dashboard/partials/assistants/instructions/editor?new=1">{{icon "plus"}}New instructions</button>
  </div>
</header>
{{template "tabs" .Data.Tabs}}
