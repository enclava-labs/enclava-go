{{define "content"}}{{/* Chat page (OA-32): three columns ≥1280 — history,
     thread, evidence. Fragments live in partials/chat_history.tmpl,
     chat_thread.tmpl and partials/evidence.tmpl; behaviors ride
     static/pages/chat.js via data-action delegation (D-20: no scripts, no
     hx-on, no inline handlers here). The attach icon from the mockup is
     deliberately omitted — no upload API exists (10-CONTEXT). */}}
<header class="head">
  <div class="headcopy">
    <div class="crumb">{{.Org}} / Chat</div>
    <h1>Chat</h1>
    <p class="desc">Secure conversations grounded in your organisation's knowledge.</p>
  </div>
  <div class="right-mobile">
    <button type="button" class="btn mobile-chats" aria-label="Show chat history" aria-expanded="false" aria-controls="mobileChats">{{icon "chat"}} Chats</button>
    <button type="button" class="btn primary" data-action="chat:new">{{icon "plus"}} New chat</button>
  </div>
</header>

<div class="thread-layout">
  <nav class="history" aria-label="Chats">
    <h2 class="visually-hidden">Chats</h2>
    <input class="field" type="search" placeholder="Search chats" aria-label="Search chats" data-chat-search>
    {{template "frag-chat-history" .}}
  </nav>

  <section class="thread" aria-label="Conversation">
    <div class="thread-head">
      <div class="stack">
        <label class="label" for="assistantSelect">Assistant</label>
        <select class="field" id="assistantSelect" aria-label="Assistant"{{if not .Data.Assistants}} disabled{{end}}>
          {{$sel := .Data.SelectedAssistant}}{{$tools := .Data.AssistantToolFlags}}{{range .Data.Assistants}}<option value="{{.ID}}"{{if eq .ID $sel}} selected{{end}}{{if index $tools .ID}} data-tools="1"{{end}}>{{.Name}}</option>{{end}}
        </select>
        <span class="help">Don't see an assistant you expected? Ask an administrator to grant your role access.</span>
        {{if not .Data.Assistants}}<span class="help">{{.Data.AssistantsEmpty.Text}}</span>{{end}}
      </div>
      {{with .Data.Thread}}{{if .AssistantName}}<div class="threadmeta">
        {{/* No assistant name here: the select already shows it. */}}
        {{if .Subline}}<span class="muted" id="chatAssistantSubline">{{.Subline}}</span>{{end}}
        {{if .ConfText}}<button type="button" class="conf-card{{if .ConfWarn}} warn{{end}}" data-action="conf-pop" aria-haspopup="dialog" aria-expanded="false" aria-controls="pop">
          <span class="conf-title">{{icon "shield"}}<strong>{{.ConfText}}</strong></span>
        </button>{{end}}
      </div>{{end}}{{end}}
    </div>

    {{template "frag-chat-thread" .}}

    {{if or .Data.NoAssistants .Data.SelectedDisabled}}
      <div class="composer-note muted">
        {{if .Data.NoAssistants}}{{.Data.AssistantsEmpty.Text}}{{else}}This assistant is no longer available. Pick another assistant to start a new conversation.{{end}}
      </div>
    {{else}}
    <div class="composer" id="chatComposer"{{if .Data.EvidenceIDsAttr}} data-evidence="{{.Data.EvidenceIDsAttr}}"{{end}}{{if and .Data.ConversationID .Data.SelectedAssistant}} data-assistant="{{.Data.SelectedAssistant}}"{{if index .Data.AssistantToolFlags .Data.SelectedAssistant}} data-tools="1"{{end}}{{end}}>
      <textarea class="field" id="composer" rows="2" placeholder="Ask a follow-up…" aria-label="Message"></textarea>
      <div class="compose-foot">
        <span class="muted" id="evidenceChip"{{if not .Data.EvidenceIDsAttr}} hidden{{end}}>Answering from the saved passages you attached.</span>
        <button type="button" class="btn primary" data-action="chat:send">{{icon "send"}} Send</button>
      </div>
    </div>
    {{end}}
  </section>

  <aside id="evidence" class="evidence-panel" aria-label="Evidence"></aside>
</div>

<div class="mobile-chats-list" id="mobileChats">
  <h2 class="visually-hidden">Chats</h2>
  <button type="button" class="btn mobile-chats" aria-expanded="false" aria-controls="mobileChats">Close chats</button>
  {{template "chat-history-items" .}}
</div>
{{end}}
