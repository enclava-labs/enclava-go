{{define "content"}}{{/* Extract Work page (OA-25, §6.5): Process / Jobs /
     Templates tabs. Handlers render only (D-17) — writes go through
     static/pages/extract.js via Enclava.api; no scripts, no hx-on (D-20). */}}
<header class="head">
  <div class="headcopy">
    <div class="crumb">{{.Org}} / Extract</div>
    <h1>Extract</h1>
    <p class="desc">Turn documents into structured, reviewable data.</p>
  </div>
</header>
{{template "tabs" .Data.Tabs}}

{{if eq .Data.Tab "process"}}
<div class="section grid two">
  <div class="card">
    {{if .Data.Templates}}
    <div class="card-title">Process a document</div>
    <div class="card-sub">The result lands in your Jobs list; completed results can be added to knowledge.</div>
    <div class="stack" style="margin-top:12px" data-extract-form>
      <div>
        <label class="label" for="extract-template">Extraction template</label>
        <select class="field" id="extract-template" data-extract-template-select>
          {{range .Data.Templates}}<option value="{{.ID}}"{{if index $.Data.Unpriced .ID}} data-unpriced{{end}}>{{.Name}}{{if .IsDefault}} · default{{end}}</option>{{end}}
        </select>
      </div>
      {{/* Real visually-hidden file input behind the styled zone (§6.5). */}}
      <input type="file" id="extract-file" class="visually-hidden" data-extract-file aria-describedby="extract-file-help">
      <label class="empty" for="extract-file" id="extract-dropzone" data-extract-dropzone>
        {{icon "upload"}}
        <p>Drop a document to extract</p>
        <span class="btn primary">Choose file</span>
      </label>
      <p class="help" id="extract-file-help" data-extract-filename hidden></p>
      <p class="help" id="extract-file-limit">PDF, Word, image or text files · up to {{count .Data.MaxUploadMB}} MB per file.</p>
      <div class="row">
        <button type="button" class="btn primary" data-action="extract:submit">{{icon "sparkles"}}Run extraction</button>
      </div>
    </div>
    {{/* Post-submit confirmation band (P-03/UX-M02/UX-H09): replaces the form
         with the queued job's identity plus a live status strip the page
         module polls on the shared 3s cadence. */}}
    <div class="extract-band" data-extract-band hidden>
      <p class="extract-band-title">{{icon "check"}} Extraction queued · <span data-extract-band-file></span> · <span class="mono" data-extract-band-id></span></p>
      <div class="row">
        <a class="btn" data-extract-band-view href="#">View job</a>
        <button type="button" class="btn ghost" data-action="extract:another">Run another</button>
      </div>
      <div class="extract-strip" data-extract-strip hidden></div>
    </div>
    {{else}}
    {{template "empty" .Data.ProcessEmpty}}
    {{end}}
  </div>
  <div class="card">
    <div class="card-title">How it works</div>
    <div class="stack" style="margin-top:10px">
      <div class="activity-row">
        <span class="activity-icon">{{icon "file"}}</span>
        <span class="activity-copy"><b>Choose a template</b><small>Only templates granted to you appear here.</small></span>
      </div>
      <div class="activity-row">
        <span class="activity-icon">{{icon "upload"}}</span>
        <span class="activity-copy"><b>Drop the document</b><small>One file per extraction; it is stored durably before processing starts.</small></span>
      </div>
      <div class="activity-row">
        <span class="activity-icon">{{icon "sparkles"}}</span>
        <span class="activity-copy"><b>Review the result</b><small>Fields, validation state, and one click into knowledge.</small></span>
      </div>
    </div>
  </div>
</div>
{{else if eq .Data.Tab "jobs"}}
<div class="section">
  {{template "frag-extract-jobs" .}}
</div>
{{else if eq .Data.Tab "templates"}}
<div class="section">
  {{template "frag-extract-templates" .}}
</div>
{{end}}
{{end}}
