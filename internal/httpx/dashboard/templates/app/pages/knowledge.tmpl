{{define "content"}}{{/* Knowledge list (OA-22, plan 09-01): readable
     collections rendered by frag-knowledge-collections. §3.4 hard split —
     the New collection control and the manager columns live only inside
     .Can.KnowledgeManage branches; a member render contains none of them.
     The drawer markup is a <template> cloned into the shared #drawer by
     knowledge.js (data-action="knowledge:new" or ?new=1). */}}
{{template "page-head" .}}
{{template "frag-knowledge-collections" .}}

{{if .Can.KnowledgeManage}}
<template id="knowledge-new-tpl">
  <div class="drawer-head">
    <h2>New collection</h2>
    <button type="button" class="iconbtn" data-action="close-drawer" aria-label="Close drawer">{{icon "x"}}<span class="visually-hidden">Close</span></button>
  </div>
  <form data-knowledge-new-form>
    <div>
      <label class="label" for="knc-name">Name</label>
      <input class="field" id="knc-name" name="name" required maxlength="200">
    </div>
    <div>
      <label class="label" for="knc-desc">Description</label>
      <input class="field" id="knc-desc" name="description" maxlength="500">
    </div>
    <div>
      <label class="label" for="knc-model">Embedding model</label>
      <select class="field" id="knc-model" name="embedding_model">
        <option value="">Deployment default ({{.Data.DefaultEmbeddingModel}})</option>
        {{range .Data.EmbeddingModels}}<option value="{{.}}">{{.}}</option>{{end}}
      </select>
      <span class="help">Only models on enabled embeddings-capable endpoints are listed.</span>
    </div>
    <div>
      <label class="label" for="knc-dims">Vector size</label>
      <select class="field" id="knc-dims" name="embedding_dimensions">
        <option value="">Recommended</option>
        <option value="0">Full size</option>
        {{range .Data.DimensionChoices}}<option value="{{.}}">{{.}} dimensions</option>{{end}}
      </select>
      <span class="help">Recommended is {{if .Data.DefaultEmbeddingDimensions}}{{.Data.DefaultEmbeddingDimensions}} dimensions for {{.Data.DefaultEmbeddingModel}} and {{end}}full size for other models. Smaller vectors take less storage; shorten only models trained for it (Matryoshka), such as Qwen3-Embedding.</span>
    </div>
    <div>
      <label class="row"><input type="checkbox" name="embed_titles" checked> Add the document name to each chunk</label>
      <span class="help">Helps tell many documents apart; turn it off for a collection that holds one long document, such as a book.</span>
    </div>
    <div>
      <label class="label" for="knc-profile">Processing profile</label>
      <select class="field" id="knc-profile" name="chunk_profile_version_id" data-knowledge-profile-select>
        <option value="">Default chunking</option>
      </select>
      <span class="help" data-knowledge-profile-note>Loaded from your processing profiles.</span>
    </div>
    <div>
      <label class="label" for="knc-access">Who can read it</label>
      <select class="field" id="knc-access" name="access">
        <option value="org">Everyone in the organization</option>
        <option value="me">Only me</option>
      </select>
    </div>
    <p class="field-error" data-knowledge-form-error hidden></p>
    <div class="drawer-actions">
      <button type="button" class="btn ghost" data-action="close-drawer">Cancel</button>
      <button type="submit" class="btn primary">Create collection</button>
    </div>
  </form>
</template>
{{end}}
{{end}}
