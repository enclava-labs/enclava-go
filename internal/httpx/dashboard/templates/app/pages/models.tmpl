{{define "content"}}{{/* Models + Pricing page (OA-27): tabs render the
     matching fragment define so page and fragment stay one source of truth.
     No scripts, no hx-on (D-20) — behaviors live in pages/models.js. */}}
<header class="head">
  <div class="headcopy">
    <div class="crumb">{{.Org}} / Models</div>
    <h1>Models</h1>
    <p class="desc">Inference endpoints with their observed assurance and health, and the pricing that routes depend on.</p>
  </div>
{{if .Can.ModelsManage}}  <div class="right-mobile">
    <button type="button" class="btn primary" data-action="models:endpoint" data-endpoint-id="">{{icon "plus"}}Add endpoint</button>
  </div>{{end}}
</header>
<nav class="tabs" aria-label="Models sections">
  <a class="tab{{if eq .Data.Tab "endpoints"}} active{{end}}" href="/dashboard/models"{{if eq .Data.Tab "endpoints"}} aria-current="page"{{end}}>Endpoints</a>
  <a class="tab{{if eq .Data.Tab "catalog"}} active{{end}}" href="/dashboard/models/catalog"{{if eq .Data.Tab "catalog"}} aria-current="page"{{end}}>Models</a>
  <a class="tab{{if eq .Data.Tab "pricing"}} active{{end}}" href="/dashboard/models/pricing"{{if eq .Data.Tab "pricing"}} aria-current="page"{{end}}>Pricing</a>
</nav>
{{if eq .Data.Tab "pricing"}}{{template "frag-models-pricing" .}}{{else if eq .Data.Tab "catalog"}}{{template "frag-models-catalog" .}}{{else}}{{template "frag-models-endpoints" .}}{{end}}
{{end}}
