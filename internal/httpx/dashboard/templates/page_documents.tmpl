{{define "page-documents"}}
{{template "layout-head" .}}
{{template "layout-nav" .}}

<main class="pt-16 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-6">
    <div>
      <h1 class="text-3xl font-display font-bold">Documents</h1>
      <p class="text-muted-foreground mt-1">Review immutable chunk profiles and preview source-linked document boundaries. Profile changes remain API-only.</p>
    </div>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6" aria-label="Preview setup">
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 space-y-4">
        <h2 class="text-lg font-display font-semibold">Choose a profile</h2>
        <div class="space-y-2">
          <label for="document-profile" class="text-sm font-medium">Existing profile version</label>
          <select id="document-profile" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" disabled>
            <option value="">Loading profiles…</option>
          </select>
        </div>
        <div id="document-profile-details" class="text-sm text-muted-foreground" aria-live="polite">Profiles are read-only here. Loading existing versions…</div>
      </div>

      <form id="document-preview-form" class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 space-y-4" enctype="multipart/form-data">
        <h2 class="text-lg font-display font-semibold">Preview a fresh document</h2>
        <div class="space-y-2">
          <label for="document-file" class="text-sm font-medium">Document file</label>
          <input id="document-file" name="file" type="file" required class="block w-full text-sm file:mr-4 file:rounded-md file:border-0 file:bg-muted file:px-3 file:py-2 file:text-sm file:font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <p class="text-xs text-muted-foreground">Upload a fresh file to create a preview. The browser does not attach existing artifacts.</p>
        </div>
        <button id="document-preview-submit" type="submit" disabled class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 disabled:opacity-50">Create preview</button>
      </form>
    </section>

    <section class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 space-y-4" aria-labelledby="document-preview-heading">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="document-preview-heading" class="text-lg font-display font-semibold">Preview status</h2>
          <p id="document-preview-status" class="mt-1 text-sm text-muted-foreground" role="status" aria-live="polite">Choose a profile and upload a fresh document to begin.</p>
        </div>
        <button id="document-preview-cancel" type="button" hidden class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border border-input bg-background hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Cancel preview</button>
      </div>
      <div id="document-preview-warnings" class="space-y-2" aria-live="polite"></div>
      <div id="document-preview-chunks" class="space-y-4"></div>
    </section>
  </div>
</main>

{{template "layout-toast" .}}
<script src="/dashboard/static/documents.js" defer></script>
{{end}}
