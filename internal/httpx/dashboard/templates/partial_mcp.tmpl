{{define "partial-mcp"}}
<div class="space-y-6" id="mcp-admin">
  <p id="mcp-admin-message" class="min-h-6 text-sm" role="status" aria-live="polite"></p>
  <section class="rounded-lg border bg-card p-5" aria-labelledby="mcp-server-form-heading">
    <h2 id="mcp-server-form-heading" class="text-lg font-semibold">Register an MCP server</h2>
    <p class="mt-1 text-sm text-muted-foreground">Only HTTPS servers are accepted, except loopback HTTP fixtures. Registration never approves tools.</p>
    <form id="mcp-server-form" class="mt-4 grid gap-3 md:grid-cols-2">
      <label class="space-y-1 text-sm font-medium">Server ID<input class="w-full rounded-md border bg-background px-3 py-2 text-sm" name="id" required></label>
      <label class="space-y-1 text-sm font-medium">Origin<input class="w-full rounded-md border bg-background px-3 py-2 text-sm" name="origin" placeholder="https://mcp.example" required></label>
      <label class="space-y-1 text-sm font-medium">Endpoint path<input class="w-full rounded-md border bg-background px-3 py-2 text-sm" name="endpoint_path" value="/mcp"></label>
      <label class="space-y-1 text-sm font-medium">Credential reference<input class="w-full rounded-md border bg-background px-3 py-2 text-sm" name="credential_ref" autocomplete="off"></label>
      <label class="space-y-1 text-sm font-medium md:col-span-2">Allowed caller scopes (comma separated)<input class="w-full rounded-md border bg-background px-3 py-2 text-sm" name="audience_scopes" placeholder="assistant.use" required></label>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="authorized_private"> Allow private destination addresses</label>
      <button class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Register server</button>
    </form>
  </section>
  <section class="rounded-lg border bg-card" aria-labelledby="mcp-servers-heading">
    <div class="border-b px-5 py-4"><h2 id="mcp-servers-heading" class="font-semibold">MCP servers and approvals</h2></div>
    <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b text-left"><th class="px-4 py-3">Server</th><th class="px-4 py-3">Origin / path</th><th class="px-4 py-3">Scopes</th><th class="px-4 py-3">State</th><th class="px-4 py-3">Actions</th></tr></thead><tbody id="mcp-server-list" class="divide-y"><tr><td class="px-4 py-4 text-muted-foreground" colspan="5">Loading servers…</td></tr></tbody></table></div>
  </section>
  <section class="rounded-lg border bg-card p-5" aria-labelledby="mcp-tools-heading">
    <h2 id="mcp-tools-heading" class="text-lg font-semibold">Discovered tools</h2>
    <p class="mt-1 text-sm text-muted-foreground">Discovery is read-only. Select a discovered tool to explicitly approve or reapprove its current schema and caller scopes.</p>
    <div id="mcp-discovery-server" class="mt-3 text-sm text-muted-foreground">Select Discover on a server above.</div>
    <div id="mcp-discovered-tools" class="mt-3 space-y-3"></div>
    <div id="mcp-approved-tools" class="mt-5 space-y-3"></div>
  </section>
</div>
<script src="/dashboard/static/mcp.js" defer></script>
{{end}}
