APP_HOST=0.0.0.0
APP_PORT=8080
# PostgreSQL connection string — postgres://, postgresql:// or key=value DSN.
# SQLite file paths / file: URIs are rejected at startup.
DATABASE_URL=postgres://enclava:enclava@localhost:5432/enclava
# Optional: DSN used by repository integration tests (go test).
# Required for the real-PostgreSQL suites; they fail hard when unset.
# ENCLAVA_TEST_DATABASE_URL=postgres://enclava:enclava@localhost:5432/enclava_test

# Durable artifact root (uploads, generated files).
ENCLAVA_DATA_DIR=./data
# Dashboard session lifetime.
SESSION_TTL=12h
MAX_UPLOAD_SIZE_MB=15

# HTTP server timeouts
HTTP_READ_TIMEOUT=30s
# For SSE streaming, keep this at 0 (disabled) unless you know you don't need streaming.
HTTP_WRITE_TIMEOUT=0
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=10s

# Provider selection: privatemode | tinfoil | openai_compatible | redpill
INFERENCE_PROVIDER=privatemode
# Output-token cap injected into chat/responses requests that set none; it
# also sizes the budget hold per request. 0 = inject nothing (hold 131072).
INFERENCE_DEFAULT_MAX_OUTPUT_TOKENS=16384

PRIVATEMODE_BASE_URL=https://api.privatemode.ai/v1
PRIVATEMODE_API_KEY=sk-...
PRIVATEMODE_TIMEOUT=120s

# Generic OpenAI-compatible provider settings. Base URLs are origins
# (e.g. http://vllm-host:8000); a trailing /v1 is accepted and normalized.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# RedPill/OpenAI-compatible confidential provider settings
REDPILL_BASE_URL=
REDPILL_API_KEY=

# Provider readiness probing (controls /readyz and startup availability)
PROVIDER_PROBE_INTERVAL=5s
PROVIDER_PROBE_TIMEOUT=10s
PROVIDER_MODEL_CACHE_TTL=5m

# RAG vector store and embedding defaults
QDRANT_URL=http://localhost:6333
# Model and vector size for collections that don't pick their own. The size
# truncates Matryoshka models (0 = full output); it defaults to 1024 for
# qwen3-embedding-4b and to full size for any other model.
DEFAULT_EMBEDDING_MODEL=qwen3-embedding-4b
DEFAULT_EMBEDDING_DIMENSIONS=1024
# Optional: enables the skipped real-Qdrant integration test when running go test.
QDRANT_INTEGRATION_URL=
# Empty disables query expansion; use an authorized configured model to enable it.
UTILITY_MODEL=
# Old index generations are retained for this long before retirement.
INDEX_RETIREMENT_SOAK=24h

# Access snapshots older than this deny access (0 explicitly disables the limit).
SOURCE_ACCESS_MAX_STALE=168h
# Per-job deadline (0 disables the deadline).
JOB_TIMEOUT=2h
# Metrics fail closed unless a token is set or authentication is explicitly disabled.
METRICS_TOKEN=
METRICS_AUTH_DISABLED=false

# Connector scheduler. 0 disables scheduled sync; sources opt in with
# config.sync_interval_seconds.
# credential_ref names a SECRET_BINDINGS reference such as CONNECTOR_GITHUB_TOKEN
# or a credential added under Sources → Credentials in the dashboard.
# SECRET_BINDINGS=CONNECTOR_GITHUB_TOKEN|TENANT_ID|connector|https://api.github.com|GITHUB_TOKEN
# Seals dashboard-managed connector credentials (openssl rand -base64 32);
# unset disables storing them.
# ENCLAVA_SECRETS_KEY=
# Browser-facing origin for connector OAuth redirect URIs.
# PUBLIC_BASE_URL=https://enclava.example.com
# base_url must be a public http(s) origin.
CONNECTOR_SYNC_INTERVAL=0

# API key hashing for keys stored in Postgres
# sha256 = legacy compatibility
# hmac_sha256 = preferred (requires API_KEY_PEPPER)
API_KEY_HASH_ALGO=sha256
API_KEY_PEPPER=
API_KEY_PREFIX=enc_
TRUST_PROXY_HEADERS=false
CORS_ALLOWED_ORIGINS=

# Optional dashboard login (if set, /dashboard uses email/password session auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tinfoil provider settings (used when INFERENCE_PROVIDER=tinfoil)
TINFOIL_API_KEY=
# Leave TINFOIL_ENCLAVE and TINFOIL_REPO empty to use the SDK-compatible
# default confidential router target. Set both together to pin a specific target.
TINFOIL_ENCLAVE=
TINFOIL_REPO=
TINFOIL_VERIFY_AT_START=true
TINFOIL_VERIFY_PER_CALL=false
TINFOIL_VERIFY_MAX_AGE=10m

# Confidential Inference SDK trust configuration: a single operator config
# JSON file, or a directory holding one <sdk-provider>.json per provider
# (e.g. chutes.json + tinfoil.json from confidential-inference-trust pin) so
# several confidential_sdk providers can run in one process.
CONFIDENTIAL_SDK_CONFIG=
# Path to libconfidential_inference_ffi.so (build the SDK FFI before starting).
CONFIDENTIAL_INFERENCE_FFI_LIBRARY=

# Optional: operator bootstrap key for first startup only.
# Must be explicitly enabled and strong (no placeholder/example keys).
BOOTSTRAP_ENABLED=false
# BOOTSTRAP_API_KEY=
BOOTSTRAP_API_KEY=
BOOTSTRAP_API_KEY_MIN_LENGTH=48
